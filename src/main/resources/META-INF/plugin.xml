<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.gitmemo.notes</id>
    <name>Git Notes</name>
    <vendor>gitmemo</vendor>

    <description><![CDATA[
        View, add, edit and delete <b>git notes</b> on commits, straight from the VCS Log.<br><br>
        Git notes live outside the commit object graph, so the bundled Git plugin does not surface them
        at all. This plugin adds:
        <ul>
            <li>a note indicator in the commit details panel of the Log, which opens an editor when clicked;</li>
            <li>a <b>Git Notes</b> tool window that follows the Log selection and edits notes inline;</li>
            <li><b>Notes</b> actions in the Log context menu, including fetch and push of the notes refs;</li>
            <li>a configurable notes namespace, for reviews or other custom refs.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>
    <!-- Optional: only the "Send to Claude Code" button needs the terminal, and note editing must keep
         working when a user disables the terminal plugin. -->
    <depends optional="true" config-file="gitmemo-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.GitMemoBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- GitNotesService and GitMemoSettings are light services (@Service) and must not be
             registered here. -->

        <projectConfigurable id="gitmemo.settings"
                             parentId="project.propVCSSupport.Mappings"
                             instance="com.gitmemo.settings.GitMemoConfigurable"
                             bundle="messages.GitMemoBundle"
                             key="settings.title"/>

        <vcsLogCommitStatusProvider implementation="com.gitmemo.log.GitNoteStatusProvider"/>

        <toolWindow id="GitNotes"
                    anchor="right"
                    icon="AllIcons.General.Balloon"
                    factoryClass="com.gitmemo.ui.GitNotesToolWindowFactory"/>
    </extensions>

    <actions>
        <group id="GitMemo.Log.Notes" text="Notes" popup="true">
            <action id="GitMemo.EditNote"
                    class="com.gitmemo.actions.EditGitNoteAction"
                    text="Edit Note..."
                    description="Edit the git note attached to the selected commit"/>
            <action id="GitMemo.DeleteNote"
                    class="com.gitmemo.actions.DeleteGitNoteAction"
                    text="Delete Note"
                    description="Delete the git note attached to the selected commit"/>
            <action id="GitMemo.CopyNote"
                    class="com.gitmemo.actions.CopyGitNoteAction"
                    text="Copy Note"
                    description="Copy the git note of the selected commit to the clipboard"/>
            <separator/>
            <action id="GitMemo.FetchNotes"
                    class="com.gitmemo.actions.FetchGitNotesAction"
                    text="Fetch Notes"
                    description="Fetch the notes refs from the remote"/>
            <action id="GitMemo.PushNotes"
                    class="com.gitmemo.actions.PushGitNotesAction"
                    text="Push Notes"
                    description="Push the notes refs to the remote"/>
            <add-to-group group-id="Vcs.Log.ContextMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
